# Bu dosyayi kopyalayip adini .env yapin:  cp .env.example .env
# .env dosyasi git'e GONDERILMEZ (.gitignore'da).

PORT=5001

# docker-compose.yml'deki degerlerle ayni olmali
DATABASE_URL=postgres://iso:iso_yerel_sifre@localhost:5432/iso_db

# En az 32 karakterlik rastgele bir metin. Uretimde mutlaka degistirin.
# Uretmek icin:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=buraya-uzun-rastgele-bir-metin-yazin-en-az-32-karakter

# Web oturumu ve kiosk oturumu suresi
JWT_SURE=12h
KIOSK_JWT_SURE=10m

# Frontend'in adresi (Vite varsayilani)
CORS_ORIGIN=http://localhost:5173

# QR etiketlerine yazilacak adres (telefonla okutunca acilacak sayfa)
ETIKET_URL=http://localhost:5173/b
