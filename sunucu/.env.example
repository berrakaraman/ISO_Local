# Bu dosyayi kopyalayin:  cp .env.example .env   ve degerleri doldurun.
# .env git'e GONDERILMEZ. Sifreleri baska bir yere de kaydedin.

# Sunucunun disaridan erisilen IP adresi (ileride alan adi: kys.firma.com)
SUNUCU_ADRESI=1.2.3.4

# Veritabani sifresi. Uretmek icin:  openssl rand -hex 24
DB_SIFRE=

# Oturum anahtari (en az 32 karakter). Uretmek icin:  openssl rand -hex 48
JWT_SECRET=

# Ilk kurulumdaki ornek veride firma kodu ve unvani (giris ekraninda firma kodu yazilir)
SEED_FIRMA_KODU=ORNEK
SEED_FIRMA_UNVANI=UNELSİS Kablo ve Spiral Sistemleri
